# PHARVO backend environment variables (copy to .env and fill in real values)

# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True

# PostgreSQL (pharvo_db)
DB_NAME=pharvo_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# WhatsApp order notifications (Meta WhatsApp Cloud API; all optional).
# Leave the two credential lines empty to run without sending: the
# send-order endpoint then answers 503 and orders stay drafts.
# Never commit real tokens to Git — keep them in .env only.
# WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_TIMEOUT_SECONDS=15

# Pharmacy details stamped into WhatsApp order messages.
# PHARMACY_NAME=PHARVO Pharmacy
# PHARMACY_PHONE=
# PHARMACY_ADDRESS=